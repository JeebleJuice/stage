{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stage",
  "version": "0.1.0",
  "identifier": "dev.jeeblejuice.stage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Stage",
      "width": 1440,
      "height": 900,
      "minWidth": 1020,
      "minHeight": 680,
      "decorations": true,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Persistent Hyprland workspaces",
    "longDescription": "Save the resources and layout for an activity, then restore them to their intended Hyprland workspaces."
  }
}
